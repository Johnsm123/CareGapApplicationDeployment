# ──────────────────────────────────────────────────────────────────────
# Secrets — NEVER COMMIT
# ──────────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
mobile/.env
mobile/.env.local

# Firebase backend service-account key — TRUE secret, never commit
firebase-admin.json

# Note: mobile/google-services.json is intentionally NOT ignored.
# It only contains client-side Firebase config (api_key, project_id, app_id) which
# is embedded in every distributed APK and extractable by anyone — it is not a secret.
# The TRUE secret for FCM push sending is firebase-admin.json above.

# Any stray credential / key files
*.pem
*.key
*_credentials.json
*-admin-key.json

